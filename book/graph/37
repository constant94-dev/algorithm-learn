날짜: 25.08.11(월)
문제 이름: 게임 맵 최단 거리
권장 시간 복잡도: O(N*M)

import java.util.*;

class Solution {
	// 동,서,남,북 이동을 위한 방향 선언
	private static final int[] rx = {0,0,1,-1};
	private static final int[] ry = {1,-1,0,0};
	// 큐에서 확인할 노드 정의
	private static class Node {
		int r,c;
		
		public Node(int row, int col) {
			this.r = row;
			this.c = col;
		}
	}

	public int ShortDistanceMap(int[][] maps) {
		// 맵 크기 저장 변수 선언
		int N = maps.length;
		int M = maps[0].length;

		// 캐릭터 좌표와 상대 좌표 값이 0이면 -1 반환
		if (maps[0][0] == 0 || maps[N-1][M-1] == 0) return -1;

		/* 최단 거리 저장할 배열 생성
		 * dist를 방문표시 겸 최단거리로 사용(0이면 미방문)
		 */
		int[][] dist = new int[N][M];
		// bfs 탐색을 위한 큐 생성
		ArrayDeque<Node> deque = new ArrayDeque<>();
		
		// 캐릭터 좌표를 큐에 추가, 최단 거리 저장
		deque.addLast(new Node(0,0));
		dist[0][0] = 1; // 시작을 1로 두면 도착 칸의 값이 '이동 칸 수'가 됨...

		// 1. 큐가 빌 때까지 순회
		while (!deque.isEmpty()) {
			// 2. 큐에서 최신 노드 가져오기
			Node now = deque.pollFirst();
			if (now.r == N - 1 && now.c == M - 1) return dist[now.r][now.c];

			// 3. 4방향 좌표 탐색
			for (int i = 0; i < 4; i++) {
				int nr = now.r + rx[i];
				int nc = now.c + ry[i];

				if (nr < 0 || nc < 0 || nr >= N || nc >= M) continue;
				if (maps[nr][nc] == 0) continue;

				if (dist[nr][nc] == 0) {
					deque.addLast(new Node(nr, nc));
					dist[nr][nc] = dist[now.r][now.c] + 1;
				}
			}
		}
		
		// 8. 위 과정 마무리 후 최단거리 반환, 목적직에 도달하지 못한 경우 -1 반환
		return dist[N-1][M-1] == 0 ? -1 : dist[N-1][M-1];
	}
}