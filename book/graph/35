날짜: 25.08.10(일)
문제 이름: 너비 우선 탐색 순회
권장 시간 복잡도: O(N+E)

class Solution {
	// 인접 리스트 저장 변수 선언
	private static ArrayList<Integer>[] adjList;
	// 방문 여부 저장 변수 선언
	private static boolean[] visited;
	// 결과 저장 변수 선언
	private static ArrayList<Integer> answers;

	public static int[] bfsTraversal(int[][] graph, int start, int n) {
		// 1. 인접 리스트 초기화
		adjList = new ArrayList[n + 1];
		for (int i = 0; i < adjList.length; i++) {
			adjList[i] = new ArrayList<>();
		}
		// 2. 그래프를 인접 리스트 변환
		for (int[] edge : graph) {
			adjList[edge[0]].add(edge[1]);
		}
		// 3. 방문 여부 변수 초기화
		visited = new boolean[n + 1];
		// 4. 결과 변수 초기화
		answers = new ArrayList<>();
		// 5. bfs 수행
		bfs(start);
		
		// 8. 위 과정을 마무리한 후 결과 반환
		return answers.stream().mapToInt(Integer::intValue).toArray();
	}

	private static void bfs(int start) {
		// 6. 큐 변수 선언
		ArrayDeque<Integer> queue = new ArrayDeque<>();
		queue.addLast(start); // 현재 노드를 큐 addLast
		visited[start] = true; // 현재 노드를 방문처리
		// 7. 큐가 비어있을 때까지 순회
		while (!queue.isEmpty()) {
			// 큐 pollFirst
			int now = queue.pollFirst();
			answers.add(now);
			// 인접 노드 bfs 수행
			for (int next : adjList[now]) {
				if (!visited[next]) {
					queue.addLast(next);
					visited[next] = true;
				}
			}
		}
	}

---
	// BFS 탐색 메서드 (그래프 간선, 시작 노드, 노드 개수)
    public int[] refactorBFSTraversal(int[][] graph, int start, int n) {
        // 1. 인접 리스트 초기화 (크기: n+1, 1번 노드부터 사용)
        @SuppressWarnings("unchecked") // 제네릭 배열 생성 경고 억제
        ArrayList<Integer>[] adjList = new ArrayList[n + 1];
        for (int i = 0; i <= n; i++) {
            adjList[i] = new ArrayList<>(); // 각 인덱스에 빈 리스트 생성
        }

        // 2. 그래프를 인접 리스트로 변환
        //    graph 배열의 각 간선을 adjList에 추가 (방향 그래프 기준)
        for (int[] edge : graph) {
            adjList[edge[0]].add(edge[1]);
        }

        // 3. 방문 여부 배열 초기화 (false로 시작)
        boolean[] visited = new boolean[n + 1];
        // BFS 결과를 저장할 리스트
        ArrayList<Integer> answers = new ArrayList<>();

        // 4. BFS 수행
        bfs(start, adjList, visited, answers);

        // 5. 결과 리스트를 int[]로 변환하여 반환
        return answers.stream().mapToInt(Integer::intValue).toArray();
    }

    // BFS 구현 메서드
    private void refactorBFS(int start, ArrayList<Integer>[] adjList, boolean[] visited, ArrayList<Integer> answers) {
        // 큐 생성 (ArrayDeque 사용, addLast / pollFirst로 구현)
        ArrayDeque<Integer> queue = new ArrayDeque<>();
        
        // 시작 노드를 큐에 넣고 방문 처리
        queue.addLast(start);
        visited[start] = true;

        // 큐가 빌 때까지 반복
        while (!queue.isEmpty()) {
            // 큐의 맨 앞에서 노드를 꺼냄
            int now = queue.pollFirst();
            // 꺼낸 노드를 결과 리스트에 추가
            answers.add(now);

            // 현재 노드(now)의 모든 인접 노드 확인
            for (int next : adjList[now]) {
                // 아직 방문하지 않은 노드만 큐에 추가
                if (!visited[next]) {
                    queue.addLast(next);    // 큐에 추가
                    visited[next] = true;   // 방문 처리
                }
            }
        }
    }
}