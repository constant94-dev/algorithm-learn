날짜: 25.08.10(일)
문제 이름: 깊이 우선 탐색 순회
권장 시간 복잡도: O(N+E)

import java.util.*;

class Solution {
	
	// 인접 리스트 저장할 ArrayList 배열
	private static ArrayList<Integer>[] adjList;	
	// 방문 여부를 저장할 boolean 배열
	private static boolean[] visited;
	// 결과를 저장할 ArrayList
	private static ArrayList<Integer> answers;

	public static int[] dfsTraversal(int[][] graph, int start, int n) {
		// 1. 인접 리스트 초기화
		adjList = new ArrayList[n + 1];
		for (int i = 0; i < adjList.length; i++) {
			adjList[i] = new ArrayList<>();
		}
		// 2. 그래프를 인접 리스트로 변환
		for (int[] edge : graph) {
			adjList[edge[0]].add(edge[1]);
		}
		// DFS를 순회한 결과를 반환
		visited = new boolean[n + 1];
		answers = new ArrayList<>();
		dfs(start); // 7. 시작 노드에서 깊이 우선 탐색 시작

		// 8. DFS 탐색 결과 반환
		return answers.stream().mapToInt(Integer::intValue).toArray();
	}

	private static void dfs(int now) {
		// 4. 현재 노드를 방문했음을 저장
		visited[now] = true;
		// 5. 현재 노드를 결과 리스트에 추가
		answers.add(now);
		// 6. 현재 노드와 인접한 노드 순회
		for (int next : adjList[now]) {
			if (!visited[next]) { // 방문하지 않은 경우 인접 노드 순회
				dfs(next);
			}
		}
	}

---
	// DFS 전체 과정을 실행하는 메서드 (그래프 간선, 시작 노드, 노드 개수)
    public int[] dfsTraversal(int[][] graph, int start, int n) {
        // 1. 인접 리스트 초기화 (배열 형태, 1번 노드부터 사용)
        @SuppressWarnings("unchecked") // 제네릭 배열 생성 경고 억제
        ArrayList<Integer>[] adjList = new ArrayList[n + 1];
        for (int i = 0; i <= n; i++) {
            adjList[i] = new ArrayList<>(); // 각 인덱스에 빈 리스트 생성
        }

        // 2. 그래프를 인접 리스트로 변환
        //    graph 배열의 각 간선을 adjList에 추가 (방향 그래프 기준)
        for (int[] edge : graph) {
            adjList[edge[0]].add(edge[1]);
        }

        // 3. 방문 여부 배열 초기화 (false로 시작)
        boolean[] visited = new boolean[n + 1];
        // DFS 결과를 저장할 리스트
        ArrayList<Integer> answers = new ArrayList<>();

        // 4. DFS 수행 시작
        dfs(start, adjList, visited, answers);

        // 5. 결과 리스트를 int[]로 변환하여 반환
        return answers.stream().mapToInt(Integer::intValue).toArray();
    }

    // DFS 탐색 메서드 (재귀 방식)
    private void dfs(int now, ArrayList<Integer>[] adjList, boolean[] visited, ArrayList<Integer> answers) {
        // 현재 노드를 방문 처리
        visited[now] = true;
        // 현재 노드를 결과 리스트에 추가
        answers.add(now);

        // 현재 노드(now)와 연결된 인접 노드 순회
        for (int next : adjList[now]) {
            // 아직 방문하지 않은 노드만 재귀 호출
            if (!visited[next]) {
                dfs(next, adjList, visited, answers);
            }
        }
    }
}